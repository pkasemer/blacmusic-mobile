# The Blac backend the app talks to (not a secret). Copy this file to .env.
# Leave the line out to use the backend on this computer (dev builds) or the built-in sample data (release builds).
EXPO_PUBLIC_BLAC_API_URL=https://blacmusic.pkasemer.com
# Require a 6 digit email code at sign-up. Off by default for https servers until production can send email.
# EXPO_PUBLIC_REQUIRE_EMAIL_CODE=true
